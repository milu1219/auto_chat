{
  "manifest_version": 3,
  "name": "Zalo Auto Message Scheduler",
  "version": "1.0",
  "description": "Tự động hẹn giờ và gửi tin nhắn soạn sẵn trên Zalo Web",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://chat.zalo.me/*",
    "https://www.messenger.com/*",
    "https://www.facebook.com/messages/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Hẹn giờ tin nhắn Zalo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
